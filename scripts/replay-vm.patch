+		tracer.CaptureEnter(CALL, caller.Address(), addr, input, gas, value)
+		defer func(start uint64) { tracer.CaptureExit(ret, start-leftOverGas, err) }(gas)
+	}
 	if evm.vmConfig.NoRecursion && evm.depth > 0 {
 		return nil, gas, nil
 	}
