+// ReplayNestedCalls identifies the optional observation hooks in this build.
+func (*EVM) ReplayNestedCalls() {}
+
+type replayCallTracer interface {
+	CaptureEnter(OpCode, common.Address, common.Address, []byte, uint64, *big.Int)
+	CaptureExit([]byte, uint64, error)
+}
+
+func (evm *EVM) replayTracer() replayCallTracer {
+	if !evm.vmConfig.Debug || evm.depth == 0 {
+		return nil
+	}
+	tracer, _ := evm.vmConfig.Tracer.(replayCallTracer)
+	return tracer
+}
+
 // Call executes the contract associated with the addr with the given input as
